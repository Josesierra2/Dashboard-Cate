# Ruta base del API de retos. Por defecto: /api/retos (pasa por el proxy de Vite).
VITE_RETOS_API=/api/retos
# URL del backend Spring Boot que usa el proxy de Vite en desarrollo.
VITE_BACKEND_URL=http://localhost:8080

# Ruta base del API de categorías. Por defecto: /api/categorias
VITE_CATEGORIAS_API=/api/categorias
